   "source": [
    "dados = []\n",
    "for estado, cidades in estados_cidades_bairros_lojas.items():\n",
    "    for cidade, bairros in cidades.items():\n",
    "        for bairro, lojas in bairros.items():\n",
    "            for loja in lojas:\n",
    "                for produto in produtos:\n",
    "                    for cliente in clientes:\n",
    "                        faturamento = int(np.random.randint(1, 20))  # 1000 a 20000\n",
    "                        custo = int(faturamento * np.random.uniform(0.6, 0.8)) + 1  # 60% a 80% do faturamento\n",
    "                        dados.append({\n",
    "                            \"Estado\": estado,\n",
    "                            \"Cidade\": cidade,\n",
    "                            \"Bairro\": bairro,\n",
    "                            \"Loja\": loja,\n",
    "                            \"Produto\": produto,\n",
    "                            \"Cliente\": cliente,\n",
    "                            \"Faturamento\": faturamento,\n",
    "                            \"Custo\": custo,\n",
    "                        })\n",
    "\n",
    "# Criando o DataFrame final\n",
    "df = pd.DataFrame(dados)\n",
    "df['Lucro'] = df['Faturamento'] - df['Custo']\n",
    "df"
   ]
  },
